#include <iostream>
#include <string>

using namespace std;

int sum_digits(long long n) {
    string s = to_string(n);
    int sum = 0;
    for (char c : s) {
        sum += c - '0';
    }
    return sum;
}

int main() {
    long long n;
    cin >> n;

    if (n % sum_digits(n) == 0) {
        cout << "Yes" << endl;
    } else {
        cout << "No" << endl;
    }

    return 0;
}
