#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main() {
    double x;
    cin >> x;

    double sum = 1.0;
    double term = 1.0;
    for (int i = 1; ; ++i) {
        term *= x / i;
        if (abs(term) < 1e-9) {
            break;
        }
        sum += term;
    }

    cout << fixed << setprecision(4) << sum << endl;

    return 0;
}
