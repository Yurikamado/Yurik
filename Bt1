#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

string decToHex(int n) {
    string hex = "";
    while (n > 0) {
        int rem = n % 16;
        if (rem < 10) {
            hex += (rem + '0');
        } else {
            hex += (rem - 10 + 'A');
        }
        n /= 16;
    }
    reverse(hex.begin(), hex.end());
    return hex;
}

int main() {
    int n;
    cin >> n;
    cout << decToHex(n) << endl;
    return 0;
}
